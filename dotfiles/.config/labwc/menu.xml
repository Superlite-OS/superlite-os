<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
<menu id="root-menu" label="root-menu">
		<item label="Logout">
			<action name="Execute"><command>labwc --exit</command></action>
		</item>
		<item label="Suspend">
			<action name="Execute"><command>sudo zzz</command></action>
		</item>
		<item label="Restart">
			<action name="Execute"><command>sudo reboot -i</command></action>
		</item>
		<item label="Shutdown">
			<action name="Execute"><command>sudo poweroff</command></action>
		</item>
	<separator/>
	<menu id="Power" label="Tool">
		<item label="File">
			<action name="Execute"><command>doublecmd</command></action>
		</item>
		<item label="E-Mail">
			<action name="Execute"><command>thunderbird</command></action>
		</item>
		<item label="Browser">
			<action name="Execute"><command>google-chrome-stable</command></action>
		</item>
		<item label="Terminal">
			<action name="Execute"><command>foot</command></action>
		</item>
		<separator/>
		<item label="Clear Terminals">
			<action name="Execute"><command>/root/.config/scripts/tty-clear.sh</command></action>
		</item>
	</menu>
 <!-- Other -->
		<separator/>

	<menu id="Display" label="Display">
		<item label="Settings...">
			<action name="Execute"><command>sh -c "/root/.config/scripts/display-settings.sh"</command></action>
		</item>
		<separator/>
		<item label="Reset to Native">
			<action name="Execute"><command>sh -c "OUT=$(wlr-randr | head -1 | awk '{print $1}'); wlr-randr --output \"$OUT\" --preferred --scale 1"</command></action>
		</item>
		<item label="Show Current">
			<action name="Execute"><command>foot -e sh -c "wlr-randr; echo; printf 'Press Enter to close...'; read _"</command></action>
		</item>
	</menu>

	<menu id="Wallpaper" label="Wallpaper">
		<item label="Default Wallpaper">
			<action name="Execute"><command>sh -c "pkill swaybg; swaybg -i ~/Pictures/wallpapers/default.png -m fill &amp;"</command></action>
		</item>
		<item label="Random Wallpaper">
			<action name="Execute"><command>sh -c "pkill swaybg; f=$(ls ~/Pictures/wallpapers/*.jpg ~/Pictures/wallpapers/*.png ~/Pictures/wallpapers/*.webp 2>/dev/null | shuf -n1); [ -n \"$f\" ] &amp;&amp; swaybg -i \"$f\" -m fill &amp;"</command></action>
		</item>
	</menu>

	<menu id="Vpn" label="VPN">
		<item label="Connect">
			<action name="Execute"><command>/root/.config/scripts/vpn.sh connect</command></action>
		</item>
		<item label="Disconnect">
			<action name="Execute"><command>/root/.config/scripts/vpn.sh disconnect</command></action>
		</item>
		<item label="Register WARP">
			<action name="Execute"><command>foot -e sh -c "wgcf register; wgcf generate; echo Done; read"</command></action>
		</item>
	</menu>
</menu> <!-- root-menu -->
</openbox_menu>
