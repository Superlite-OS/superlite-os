# SuperLite OS — Catppuccin Mocha Theme (labwc)
# Unified with waybar Frost Glass / Catppuccin Mocha palette
#
# Base:     #1e1e2e  (bg)
# Mantle:   #181825  (darker bg)
# Surface0: #313244  (surface)
# Surface1: #45475a  (hover)
# Text:     #cdd6f4  (primary text)
# Subtext0: #a6adc8  (secondary text)
# Blue:     #89b4fa  (accent)
# Lavender: #b4befe  (secondary accent)
# Mauve:    #cba6f7  (tertiary accent)
# Red:      #f38ba8  (close/danger)
# Peach:    #fab387  (warning)

# general
border.width: 2
padding.height: 3

# window border
window.active.border.color: #89b4fa
window.inactive.border.color: #45475a

# window titlebar background
window.active.title.bg.color: #1e1e2e
window.inactive.title.bg.color: #181825

# window titlebar text
window.active.label.text.color: #cdd6f4
window.inactive.label.text.color: #6c7086
window.label.text.justify: left

# window button width and spacing
window.button.width: 16

# window buttons
window.active.button.unpressed.image.color: #a6adc8
window.inactive.button.unpressed.image.color: #585b70
window.active.button.close.unpressed.image.color: #f38ba8
window.active.button.max.unpressed.image.color: #a6e3a1

# menu
menu.items.bg.color: #1e1e2e
menu.items.text.color: #cdd6f4
menu.items.active.bg.color: #313244
menu.items.active.text.color: #89b4fa
menu.items.padding.x: 8
menu.items.padding.y: 4
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3
menu.separator.color: #45475a

# on screen display (window-cycle dialog)
osd.bg.color: #1e1e2e
osd.border.color: #45475a
osd.border.width: 1
osd.label.text.color: #cdd6f4
osd.window-switcher.preview.border.width: 2
osd.window-switcher.preview.border.color: #89b4fa

# window drop-shadows
window.active.shadow.size: 40
window.inactive.shadow.size: 20
window.active.shadow.color: #00000060
window.inactive.shadow.color: #00000040

# snapping overlay
snapping.overlay.region.bg.color: #89b4fa40
snapping.overlay.edge.bg.color: #89b4fa30
snapping.overlay.region.border.width: 2
snapping.overlay.edge.border.width: 1
snapping.overlay.region.border.color: #89b4fa
snapping.overlay.edge.border.color: #89b4fa
