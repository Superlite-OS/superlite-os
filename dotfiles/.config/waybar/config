{
    "layer": "top",
    "position": "bottom",
    "height": 38,
    "margin-bottom": 6,
    "spacing": 0,
    "modules-left": [
        "clock"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/search",
        "pulseaudio",
        "network",
        "battery"
    ],
    "clock": {
        "format": "\uf017 {:%a %d %b   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 2,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "days": "<span color='#a6adc8'><b>{}</b></span>",
                "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
                "today": "<span color='#f5c2e7'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/search": {
        "format": "\uf002 Search",
        "on-click": "$HOME/.config/scripts/file-search.sh",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf6a9 Muted",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "tooltip-format": "{desc} \u2014 {volume}%\n\nClick: Mute toggle\nRight-click: Set 50%\nScroll: Adjust ±5%",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pactl set-sink-volume @DEFAULT_SINK@ 50%",
        "on-scroll-up": "sh -c 'VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | sed -n \"s/.* \\([0-9]*\\)%.*/\\1/p\" | head -1); if [ \"$VOL\" -lt 96 ] 2>/dev/null; then pactl set-sink-volume @DEFAULT_SINK@ +5%; else pactl set-sink-volume @DEFAULT_SINK@ 100%; fi'",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },
    "network": {
        "format-wifi": "\uf1eb {signalStrength}%",
        "format-ethernet": "\uf0e8 Connected",
        "format-disconnected": "\uf05e Offline",
        "tooltip-format": "{essid} [{signalStrength}%] \u2014 {ipaddr}",
        "on-click-right": "foot sudo nmtui",
        "on-click": "if sudo nmcli networking connectivity | grep -q none; then sudo nmcli networking on && notify-send 'Wi-Fi On'; else sudo nmcli networking off && notify-send 'Wi-Fi Off'; fi"
    },
    "battery": {
        "states": {
            "warning": 15,
            "critical": 5
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf0e7 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{power}W \u2014 {capacity}%",
        "interval": 30
    }
}
