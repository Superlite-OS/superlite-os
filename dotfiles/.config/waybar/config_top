{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "spacing": 0,
    "modules-left": [
        "wlr/taskbar"
    ],
    "modules-center": [
        "cpu",
        "memory",
        "disk"
    ],
    "modules-right": [
        "network#speed",
        "custom/connections"
    ],
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "SuperLite",
        "on-click": "minimize-raise",
        "on-click-middle": "close",
        "rewrite": {
            "Firefox Web Browser": "",
            "Foot": "",
            "Double Commander": "",
            "Code - OSS - URL Handler": "Code",
            "Telegram Desktop": "Telegram",
            "Thunderbird": "Mail"
        }
    },
    "cpu": {
        "format": "\uf2db {usage}%",
        "tooltip-format": "{avg_frequency} GHz \u2014 {usage}% used",
        "interval": 3
    },
    "memory": {
        "format": "\uf5dc {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "interval": 5
    },
    "disk": {
        "format": "\uf1c0 {percentage_used}%",
        "tooltip-format": "{used} / {total} \u2014 {path}",
        "interval": 30
    },
    "network#speed": {
        "format": "\uf062 {bandwidthUpBytes}  \uf063 {bandwidthDownBytes}",
        "tooltip-format": "{ipaddr}/{cidr} \u2014 {ifname}",
        "interval": 2
    },
    "custom/connections": {
        "exec": "$HOME/.config/scripts/conn-count.sh",
        "format": "{}",
        "tooltip-format": "TCP + UDP connections",
        "interval": 3
    }
}
